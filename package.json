{
  "name": "screenferry",
  "version": "1.0.0",
  "description": "Framework-agnostic zero-backend TypeScript library for transferring files via animated 2D barcodes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukeAFullard/screenferry.git"
  },
  "homepage": "https://github.com/LukeAFullard/screenferry#readme",
  "bugs": {
    "url": "https://github.com/LukeAFullard/screenferry/issues"
  },
  "keywords": [
    "qr-code",
    "file-transfer",
    "fountain-code",
    "air-gap",
    "offline",
    "camera",
    "luby-transform"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "qr:capacity": "node scripts/qr-capacity.mjs",
    "demo": "vite build && npx --yes serve -l 5500 ."
  },
  "license": "MIT",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ngraveio/bc-ur": "^1.1.13",
    "buffer": "^6.0.3",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "process": "^0.11.10",
    "uqr": "^0.1.3",
    "zxing-wasm": "^3.1.3"
  }
}
